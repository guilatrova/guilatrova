# Copy to .env and replace the placeholders. This value is a JSON array on one line.
ORCA_STATS_SOURCES='[{"path":"/absolute/path/to/orca-stats.json"}]'
# An SSH source has this shape: {"host":"user@ssh-alias","path":"/absolute/remote/path/orca-stats.json","port":22}
# Add any number of local or SSH sources to the array. Never repeat the same source.
